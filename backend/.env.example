# ==============================
# Application
# ==============================
APP_NAME=Messenger Clone API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==============================
# Database (PostgreSQL)
# ==============================
# Sync URL (used by Alembic migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messenger_db
# Async URL (used by the running app)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/messenger_db

# ==============================
# JWT Auth
# ==============================
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=471004053de92ebc09b5ab1726bc268860300b20a2896c1d46d3677935c5026c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================
# File storage
# ==============================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
BASE_URL=http://localhost:8000

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_PER_MINUTE=60
